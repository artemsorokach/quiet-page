{
  "name": "quiet-page",
  "private": true,
  "version": "2.0.0-dev",
  "description": "A quiet, private space for self-reflection",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
