{
  "name": "quiet-page",
  "private": true,
  "version": "2.0.0-dev",
  "description": "A quiet, private space for self-reflection",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" \"src/**/*.test.ts\"",
    "e2e": "vite build --mode e2e && node e2e/account.e2e.mjs && node e2e/screens.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "firebase": "^13.1.0",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
